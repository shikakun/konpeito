{
  "name": "@shikakun/konpeito",
  "version": "0.2.2",
  "description": "A self-hosted feed reader for Cloudflare Workers and D1",
  "license": "MIT",
  "repository": "github:shikakun/konpeito",
  "type": "module",
  "bin": {
    "konpeito": "bin/konpeito.mjs"
  },
  "files": [
    "bin",
    "dist",
    "migrations",
    "!dist/konpeito/.dev.vars",
    "!dist/**/.vite"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && node bin/konpeito.mjs update",
    "deploy:demo": "vite build && node scripts/deploy-demo.mjs",
    "generate:routes": "node scripts/generate-routes.mjs",
    "typecheck": "node scripts/generate-routes.mjs && tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types",
    "prepare": "wrangler types && node scripts/generate-routes.mjs",
    "prepack": "vite build && node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "wrangler": "^4.128.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@base-ui/react": "^1.7.0",
    "@biomejs/biome": "^2.5.11",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-virtual": "^3.14.10",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "feedsmith": "^2.9.6",
    "hono": "^4.13.5",
    "jsdom": "^30.0.1",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
